# ============================================================
# ROOT — aplikasi Persuratan (backend + frontend)
# Catatan: .gitignore di root berlaku untuk SEMUA subfolder.
# ============================================================

# ---------- Secret / environment (WAJIB diabaikan) ----------
# Berisi KEYCLOAK_CLIENT_SECRET, password admin Keycloak, password DB.
# Jangan pernah commit file .env ke repo.
.env
.env.*
!.env.example

# ---------- Dependency & hasil build ----------
node_modules/
.next/
out/
build/
*.tsbuildinfo

# ---------- Log ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Data runtime hasil mount docker-compose ----------
data/backend/
data/frontend/

# ---------- Upload runtime backend ----------
backend/uploads/*
!backend/uploads/.gitkeep

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
