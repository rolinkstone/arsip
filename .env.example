# ============================================================
# CONTOH konfigurasi untuk `docker compose`
# ============================================================
# Salin file ini menjadi `.env` lalu isi nilainya:
#     copy .env.example .env     (Windows)
#     cp .env.example .env       (Linux / macOS)
#
# File `.env` TIDAK ikut ter-commit (lihat .gitignore).
# docker-compose.yml mengambil nilainya dari file ini.
#
# ⚠️⚠️ PENTING: file ini IKUT TER-COMMIT ke repo (lihat .gitignore:
# "!.env.example"), jadi JANGAN menulis password / client secret /
# NEXTAUTH_SECRET yang asli di sini. Nilai asli hanya di `.env`.
# ============================================================

# --- Port host ---
# PORT_FRONTEND HARUS 3005 (script "start" di frontend/package.json memakai
# `next start -p 3005`, jadi port dikunci di sana).
PORT_BACKEND=5004
PORT_FRONTEND=3005
# Origin yang BOLEH memanggil API dari browser. Boleh lebih dari satu,
# pisahkan dengan koma. Di production isi domain publik (bukan localhost).
CORS_ORIGIN=https://ecipar.bbpompky.id,http://localhost:3005

# --- Database MySQL (ada di HOST, di luar Docker) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ganti_dengan_user_db
DB_PASSWORD=ganti_dengan_password_db
DB_NAME=surat_bbpompky

# --- Integrasi TALAWANG (sumber kegiatan & nominatif pegawai) ---
TALAWANG_API_URL=http://localhost:5000

# --- Keycloak ---
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ganti_dengan_password_admin
KEYCLOAK_CLIENT_ID=ecipar
KEYCLOAK_CLIENT_SECRET=ganti_dengan_client_secret
KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master

# --- Frontend (Next.js) ---
# PENTING: semua NEXT_PUBLIC_* "ter-bake" saat image di-BUILD (lewat
# build.args di docker-compose.yml), jadi HARUS sudah benar sebelum
# `docker compose build`. Kalau nilainya diubah → build ulang image.
NEXT_PUBLIC_API_URL=https://ecipar.bbpompky.id/api
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ecipar
NEXTAUTH_URL=https://ecipar.bbpompky.id
# WAJIB diganti dengan string acak panjang (mis. hasil `openssl rand -hex 32`).
NEXTAUTH_SECRET=ganti_dengan_string_acak_panjang

# --- Cetak PDF di server (Chrome headless) ---
# Kosongkan bila ingin dicari otomatis; lihat daftar jalur di
# backend/utils/pdfRender.js. Di server Linux umumnya:
#   /usr/bin/chromium   atau   /usr/bin/google-chrome
CHROME_PATH=

# ============================================================
# YANG PERLU DISIAPKAN DI SISI KEYCLOAK (bukan di file ini):
#   Client `ecipar` harus mengizinkan domain publik, mis.:
#     Valid redirect URIs : https://ecipar.bbpompky.id/api/auth/callback/keycloak
#     Web origins         : https://ecipar.bbpompky.id
#   Juga tambahkan http://localhost:3005/* bila ingin tetap bisa dites lokal.
#   Role yang dipakai aplikasi: user, katim, admin_arsiparis.
# ============================================================
