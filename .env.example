# ============================================================
# CONTOH konfigurasi untuk `docker compose`
# ============================================================
# Salin file ini menjadi `.env` lalu isi nilainya:
#     copy .env.example .env     (Windows)
#     cp .env.example .env       (Linux / macOS)
#
# File `.env` TIDAK ikut ter-commit (lihat .gitignore).
# docker-compose.yml mengambil nilainya dari file ini.
# ============================================================

# --- Port host ---
PORT_BACKEND=5004
PORT_FRONTEND=3005
CORS_ORIGIN=http://localhost:3005

# --- Database MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ganti_dengan_user_db
DB_PASSWORD=ganti_dengan_password_db
DB_NAME=bpom_arsip_surat

# --- Keycloak ---
KEYCLOAK_SERVER_URL=https://auth.example.com
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ganti_dengan_password_admin
KEYCLOAK_CLIENT_ID=local-surat
KEYCLOAK_CLIENT_SECRET=ganti_dengan_client_secret
KEYCLOAK_ISSUER=https://auth.example.com/realms/master

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:5004/api
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.example.com/realms/master
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=local-surat
NEXTAUTH_URL=http://localhost:3005
NEXTAUTH_SECRET=ganti_dengan_string_acak_panjang
