# ============================================================
# CONTOH konfigurasi BACKEND (dijalankan dengan `node server.js`)
# ============================================================
# Salin menjadi `backend/.env` lalu isi nilainya:
#     copy backend\.env.example backend\.env
#
# PENTING: `server.js` memuat `.env` LEBIH DULU daripada `.env.local`,
# jadi nilai yang dipakai backend adalah yang ada di `.env`.
# ============================================================

# --- Server ---
PORT=5004
CORS_ORIGIN=http://localhost:3005

# --- Keycloak ---
KEYCLOAK_SERVER_URL=https://auth.example.com
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ganti_dengan_password_admin
KEYCLOAK_CLIENT_ID=local-surat
KEYCLOAK_CLIENT_SECRET=ganti_dengan_client_secret

# --- Security ---
JWT_SECRET=ganti_dengan_string_acak_panjang
SESSION_SECRET=ganti_dengan_string_acak_panjang

# --- Database MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ganti_dengan_user_db
DB_PASSWORD=ganti_dengan_password_db
DB_NAME=bpom_arsip_surat

# --- Integrasi TALAWANG (aplikasi lain, sumber kegiatan/nominatif) ---
TALAWANG_API_URL=http://localhost:5000
