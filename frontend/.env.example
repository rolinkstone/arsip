# ============================================================
# CONTOH konfigurasi FRONTEND (Next.js, `npm run dev` / `npm run start`)
# ============================================================
# Salin menjadi `frontend/.env.local` lalu isi nilainya:
#     copy frontend\.env.example frontend\.env.local
#
# Catatan:
# - `.env.local` MENANG atas `.env`.
# - NEXT_PUBLIC_* di-bake saat `npm run build` → wajib build ulang bila diubah.
# ============================================================

# --- Backend API ---
# Nilai di bawah untuk MENJALANKAN MANUAL di laptop (localhost).
# Di production (di dalam image, ter-bake saat build) nilainya:
#   BASE_URL              = https://ecipar.bbpompky.id
#   NEXT_PUBLIC_API_URL   = https://ecipar.bbpompky.id/api
BASE_URL=http://localhost:5004
NEXT_PUBLIC_API_URL=http://localhost:5004/api

# --- Proxy API (server-side) ---
# Browser TIDAK lagi memanggil backend secara langsung dan tidak pernah memegang
# token Keycloak. Semua panggilan masuk ke /api/proxy/... di aplikasi ini, lalu
# diteruskan oleh server Next.js ke backend dengan header
# `Authorization: Bearer <accessToken>` yang diambil dari cookie sesi httpOnly
# (lihat frontend/pages/api/proxy/[...path].js).
# Opsional: alamat backend yang dipakai SERVER (boleh alamat internal, mis.
# http://127.0.0.1:5004/api supaya tidak lewat nginx). Kosongkan = pakai
# NEXT_PUBLIC_API_URL.
# BACKEND_INTERNAL_URL=http://127.0.0.1:5004/api

# --- Keycloak ---
KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=ecipar
KEYCLOAK_CLIENT_SECRET=ganti_dengan_client_secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ganti_dengan_password_admin

# --- Keycloak (TIDAK dipakai lagi — boleh dibiarkan kosong) ---
# Dulu dipakai komponen client untuk menyusun URL logout SSO dan ikut ter-bake
# saat build. Logout SSO sekarang dikerjakan server (events.signOut di
# pages/api/auth/[...nextauth].js) memakai idToken dari cookie sesi, jadi
# variabel NEXT_PUBLIC_KEYCLOAK_* tidak dibaca kode mana pun.
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ecipar

# --- NextAuth ---
# Production: NEXTAUTH_URL=https://ecipar.bbpompky.id
NEXTAUTH_URL=http://localhost:3005
NEXTAUTH_SECRET=ganti_dengan_string_acak_panjang
